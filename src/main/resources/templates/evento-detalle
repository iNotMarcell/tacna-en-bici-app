<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title th:text="${evento.titulo} + ' - Tacna en Bici'">Detalle de Noticia</title>
  <link rel="icon" type="image/png" th:href="@{/img/favicon.png}">

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" th:href="@{/css/style.css}">

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #ffffff;
      color: #111;
    }

    .article-header {
      padding-top: 150px;
      padding-bottom: 50px;
      background-color: #f8f9fa;
      border-bottom: 1px solid #eaedf2;
    }

    .category-badge {
      background-color: #111;
      color: #fff;
      padding: 6px 16px;
      border-radius: 50px;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .article-title {
      font-size: 3.5rem;
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -1px;
      margin: 24px 0;
    }

    .article-meta {
      display: flex;
      align-items: center;
      gap: 20px;
      color: #555;
      font-size: 0.95rem;
      flex-wrap: wrap;
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .article-hero-img {
      width: 100%;
      height: 600px;
      object-fit: cover;
      border-radius: 24px;
      margin-top: -40px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.08);
      position: relative;
      z-index: 10;
      background-color: #eee;
    }

    .article-body {
      max-width: 800px;
      margin: 60px auto;
      font-size: 1.15rem;
      line-height: 1.8;
      color: #333;
    }

    .article-body p {
      margin-bottom: 1.5rem;
    }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #111;
      font-weight: 600;
      text-decoration: none;
      margin-bottom: 30px;
      transition: transform 0.2s;
    }

    .btn-back:hover {
      transform: translateX(-5px);
      color: #555;
    }

    .navbar-pill .nav-link,
    .navbar-pill .navbar-brand,
    .navbar-pill .navbar-brand span,
    .navbar-pill .navbar-brand svg,
    .navbar-pill .navbar-brand i,
    .navbar-pill .text-white {
      color: #111111 !important;
    }
    .navbar-pill .nav-btn-outline {
      color: #111111 !important;
      border-color: rgba(0, 0, 0, 0.3) !important;
    }
    .navbar-pill .nav-btn-outline:hover {
      background-color: #111111 !important;
      color: #ffffff !important;
    }
    .navbar-pill .nav-link:hover {
      color: #666666 !important;
    }

    @media (max-width: 768px) {
      .article-title { font-size: 2.2rem; }
      .article-hero-img { height: 350px; margin-top: -20px; border-radius: 16px; }
      .article-header { padding-top: 120px; }
    }
  </style>
</head>
<body>

<div th:replace="~{fragments/navbar :: navbar}"></div>

<header class="article-header">
  <div class="container px-4">
    <div class="row justify-content-center">
      <div class="col-lg-10 col-xl-8">
        <a th:href="@{/eventos}" class="btn-back">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Volver a Noticias
        </a>

        <div>
          <span class="category-badge" th:text="${evento.categoria}">Categoría</span>
        </div>

        <h1 class="article-title" th:text="${evento.titulo}">Título de la Noticia</h1>

        <p class="fs-4 text-secondary mb-4" th:text="${evento.extracto}" style="line-height: 1.4;">Extracto breve de la noticia.</p>

        <div class="article-meta">
          <div class="meta-item">
            <img src="https://i.pravatar.cc/150?img=11" alt="Autor" style="width:32px; height:32px; border-radius:50%;">
            <strong class="text-dark" th:text="${evento.autor}">Admin</strong>
          </div>
          <div class="meta-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span th:text="${#temporals.format(evento.fechaPublicacion, 'dd MMMM, yyyy')}">Fecha</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<main class="container px-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <img th:src="${evento.imagen != null and evento.imagen != '' ? evento.imagen : 'https://images.unsplash.com/photo-1517649763962-0c623066013b?auto=format&fit=crop&w=1200&q=80'}"
           class="article-hero-img"
           alt="Imagen de la noticia">
    </div>
  </div>

  <div class="article-body">
    <div th:utext="${evento.contenido}" style="white-space: pre-line;">
      Aquí va el contenido completo de la noticia.
    </div>

    <hr class="my-5">

    <div class="d-flex justify-content-center">
      <a th:href="@{/eventos}" class="btn btn-outline-dark rounded-pill px-5 py-3 fw-bold">
        Leer más noticias
      </a>
    </div>
  </div>
</main>

<div th:replace="~{fragments/footer :: footer}"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
